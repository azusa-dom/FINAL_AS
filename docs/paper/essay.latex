\subsection{Error Analysis Results}
\begin{table}[htbp]
\centering
\resizebox{\textwidth}{!}{%
\begin{tabular}{@{}lcccc@{}}
\toprule
\textbf{Model} & \textbf{Error Rate} & \textbf{Log Loss} & \textbf{Primary Error Type} & \textbf{Error Distribution} \\ \midrule
