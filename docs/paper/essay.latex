\subsubsection{Detailed Usage Records}
\textbf{Date}: December 2024 - January 2025
\paragraph{Usage Scenario 1: Grammar Checking and Language Optimization}
\begin{itemize}
    \item \textbf{Prompt}: "Please review this academic paragraph for grammar, clarity, and academic tone"
    \item \textbf{Output}: Grammar correction suggestions and expression optimization
    \item \textbf{Modification Method}: Selectively adopted suggestions while maintaining original core content
\end{itemize}

\paragraph{Usage Scenario 2: Structural Optimization}
\begin{itemize}
    \item \textbf{Prompt}: "Help me organize this methodology section for better flow"
    \item \textbf{Output}: Paragraph reorganization suggestions
    \item \textbf{Modification Method}: Reorganized paragraph order while preserving all original content
\end{itemize}

\paragraph{Usage Scenario 3: Table Format Optimization}
\begin{itemize}
    \item \textbf{Prompt}: "Format this table for better readability in academic writing"
    \item \textbf{Output}: Table formatting suggestions
    \item \textbf{Modification Method}: Adopted formatting suggestions while preserving all original data
\end{itemize}

\subsubsection{Originality Declaration}
All core content, data, methods, and conclusions are original to the author. AI tools were used only for:
\begin{itemize}
    \item Grammar and spelling checking
    \item Expression clarity optimization
    \item Format and structure improvements
\end{itemize}
\textbf{No AI-generated new content or original ideas}.
