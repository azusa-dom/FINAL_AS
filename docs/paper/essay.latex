\section{Reproducibility Specifications}
\subsection{Code Repository Information}
\begin{itemize}
    \item \textbf{GitHub Repository}: \url{https://github.com/username/DDI-AS-Framework}
    \item \textbf{Version Tag}: v1.2.0
    \item \textbf{License}: MIT License
\end{itemize}

\subsection{Environment Configuration}
\begin{itemize}
    \item \textbf{Docker Image}: \texttt{ddi-as:latest}
    \item \textbf{Base Image}: \texttt{ubuntu:22.04}
    \item \textbf{Python Version}: 3.10.12
    \item \textbf{CUDA Version}: 11.8
\end{itemize}
\textbf{Key Dependencies}:
\begin{verbatim}
torch==2.2.0
torchvision==0.17.0
scikit-learn==1.3.0
pandas==2.0.3
numpy==1.24.3
matplotlib==3.7.2
seaborn==0.12.2
shap==0.42.1
\end{verbatim}

\subsection{Execution Instructions}
\subsubsection{Environment Setup}
\begin{verbatim}
# Clone repository
git clone https://github.com/username/DDI-AS-Framework
cd DDI-AS-Framework

# Build Docker image
docker build -t ddi-as .

# Run container
docker run -it --gpus all ddi-as
\end{verbatim}

\subsubsection{Data Preparation}
\begin{verbatim}
# Download data
python scripts/download_data.py

# Data preprocessing
python scripts/preprocess_clinical.py
python scripts/preprocess_mri.py
\end{verbatim}

\subsubsection{Model Training}
\begin{verbatim}
# Train ClinicalNet
python src/clinical/train_clinical_ensemble.py

# Train ImagingNet
python src/mri/train_imaging_net.py

# Train ensemble model
python src/ensemble/train_ensemble.py
\end{verbatim}

\subsubsection{Result Reproduction}
\begin{verbatim}
# Generate all figures
python scripts/generate_all_figures.py

# Validate results
python scripts/validate_results.py
\end{verbatim}

\subsection{Random Seed Configuration}
\begin{itemize}
    \item \textbf{Global Random Seed}: 42
    \item \textbf{Component Seed Settings}:
    \begin{itemize}
        \item Data splitting: random\_state=42
        \item Model training: random\_state=42
        \item Cross-validation: random\_state=42
        \item Data augmentation: seed=42
    \end{itemize}
\end{itemize}

\subsection{Hardware Requirements}
\textbf{Minimum Requirements}:
\begin{itemize}
    \item CPU: 4 cores
    \item Memory: 8GB RAM
    \item Storage: 50GB available space
\end{itemize}
\textbf{Recommended Configuration}:
\begin{itemize}
    \item CPU: 8 cores
    \item Memory: 16GB RAM
    \item GPU: NVIDIA RTX 3080 or higher
    \item Storage: 100GB SSD
\end{itemize}

\subsection{Expected Runtime}
\begin{table}[htbp]
\centering
\caption{Expected Runtime}
\label{tab:runtime}
\begin{tabular}{@{}lll@{}}
\toprule
\textbf{Step} & \textbf{Expected Time} & \textbf{Hardware Requirements} \\ \midrule
Data preprocessing & 30 minutes & CPU \\
ClinicalNet training & 2 hours & CPU \\
ImagingNet training & 4 hours & GPU \\
Ensemble training & 1 hour & CPU \\
Figure generation & 30 minutes & CPU \\
Complete pipeline & 8 hours & GPU+CPU \\ \bottomrule
\end{tabular}
\end{table}
\clearpage

